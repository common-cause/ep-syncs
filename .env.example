# .env.example — env keys for ep-syncs. Copy to .env and fill in values.
# Regenerated by sync_projects.py --regen-env-examples; key metadata lives in the
# meta-project's credential_catalog.yaml. [central] secrets are filled automatically
# from the meta .env by --setup / --reseed-credentials.

# BigQuery service account JSON (full JSON string, unquoted)
# GCP project: proj-tmc-mem-com | SA: com-dbt@proj-tmc-mem-com.iam.gserviceaccount.com
# [central — seeded from the meta .env]
BIGQUERY_CREDENTIALS_PASSWORD=

# Airtable personal access token  [central — seeded from the meta .env]
AIRTABLE_API_KEY_PASSWORD=

# Protect the Vote (PTV) API credentials — fill in once known from sample script  [central — seeded from the meta .env]
PTV_API_KEY_PASSWORD=

# PTV admin browser-automation (ptv-tools package). Login code is emailed here
# and read from local Outlook. Storage state is per-machine (~/.ptv-tools/).
# [config — per deployment]
PTV_ADMIN_EMAIL=

# Google Sheets Credentials  [central — seeded from the meta .env]
GOOGLE_SHEETS_CREDENTIALS_PASSWORD=

# Asana API Key  [central — seeded from the meta .env]
ASANA_API_KEY_PASSWORD=
